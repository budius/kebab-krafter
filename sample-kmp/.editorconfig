root = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_filename = disabled
insert_final_newline = true
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 120

[**/generated/**]
ktlint = disabled

[**/build/**]
ktlint = disabled

[**/*.gradle.kts]
ktlint = disabled
